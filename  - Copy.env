# ==========================================================
# Need2Done — Production Environment Configuration
# ==========================================================
# Domain  : https://need2done.in
# Server  : AWS EC2 Ubuntu
# Updated : 2026-06-09
#
# INSTRUCTIONS (on EC2):
#   1. Copy this file to /home/ubuntu/Need2Done/.env
#   2. Fill in DB_PASSWORD, JWT_SECRET with strong values
#   3. Never commit the real .env to GitHub
# ==========================================================


# ----------------------------------------------------------
# SECTION 1: Public URLs
# ----------------------------------------------------------
# The live domain for all public-facing services.
# Replace with staging subdomain (e.g. preprod.need2done.in)
# if you want a separate pre-prod environment.

PUBLIC_BASE_URL=https://need2done.in
API_BASE_URL=https://need2done.in
TRACKING_BASE_URL=https://need2done.in

# Used by Vite (Admin Dashboard) at BUILD TIME.
# After changing this, run: cd admin-dashboard && npm run build
VITE_API_URL=https://need2done.in/api
VITE_API_BASE_URL=https://need2done.in


# ----------------------------------------------------------
# SECTION 2: Database Configuration (MySQL)
# ----------------------------------------------------------
# MySQL is installed on the same EC2 instance.
# DB_HOST stays as 127.0.0.1 (local connection).

DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=admin
DB_NAME=N2D
DB_PORT=3306


# ----------------------------------------------------------
# SECTION 3: Node.js Backend Server
# ----------------------------------------------------------
# Port 5000 is internal only. Nginx proxies /api → port 5000.
# Do NOT expose port 5000 directly in AWS Security Groups.

PORT=5000

# Restrict CORS to your domain only (not * in production)
CORS_ORIGIN=https://need2done.in


# ----------------------------------------------------------
# SECTION 4: WhatsApp Cloud API — Meta Credentials
# ----------------------------------------------------------
# These come from your Meta Developer Console.
# App → WhatsApp → API Setup

# Python Bot uses these env vars:
WHATSAPP_ACCESS_TOKEN=EAAiKqg3xnQABRTE0eg3jfsPCBQnv4FURy75A04h9kWNFsjhcV67xaZC6cWZCQNMHrM9QcmIEOaRLfoWyC0aBwwau3ohYGwlAjzyOSjyxZBw4C0zWAlFyOFGWjLQy9Hl8s1OG1egZBWsjZCTYiXsUQ2SISFubDGpA7rMgCQjVZAgKGkvPLZCrqZBb6jA72PNgZAL1JbpGOVJpMB53jzjvdUNJ2iZAhieDsLxAqIMhpDZAkhijaYCgxGfoHA1HoVOJZAHN3fWFJQgqjUYTuViSozRjcwUX
