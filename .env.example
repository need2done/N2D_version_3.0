# ============================================================
# Need2Done — Environment Variables Template
# ============================================================
# Copy this file as .env and fill in your real values
# Command: cp .env.example .env
# ============================================================

# ==============================
# Shared URLs & API Base
# ==============================
# TODO[AWS]: Replace with your real domain (e.g., https://need2done.in)
PUBLIC_BASE_URL=https://YOUR_DOMAIN.com
API_BASE_URL=https://YOUR_DOMAIN.com
TRACKING_BASE_URL=https://YOUR_DOMAIN.com
VITE_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=https://YOUR_DOMAIN.com

# ==============================
# Database Configuration (MySQL)
# ==============================
# TODO[AWS]: Update for RDS or EC2 MySQL
DB_HOST=127.0.0.1
DB_USER=n2d_user
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD
DB_NAME=N2D
DB_PORT=3306

# ==============================
# Backend Configurations
# ==============================
PORT=5000
CORS_ORIGIN=*

# ==============================
# WhatsApp Cloud API Configuration
# ==============================
# Get from: https://developers.facebook.com/
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_VERIFY_TOKEN=YOUR_VERIFY_TOKEN
GRAPH_API_VERSION=v19.0
INTERNAL_SECRET=YOUR_INTERNAL_SECRET

# Node Backend (duplicate refs for compatibility)
WA_VERIFY_TOKEN=YOUR_VERIFY_TOKEN
WA_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN
WA_PHONE_ID=YOUR_PHONE_NUMBER_ID

# ==============================
# App Logic / Business Configurations
# ==============================
ADMIN_PHONE_NUMBER=91XXXXXXXXXX
HELPER_NUMBERS=91XXXXXXXXXX,91XXXXXXXXXX
HELPER_CHARGE=20
PLATFORM_FEE=5
UPI_ID=YOUR_UPI_ID@bank
CURRENCY_SYMBOL=INR
UPI_NOTE_PREFIX=Need2Done Order
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3
AUTO_ASSIGN_TIMEOUT=30
AUTO_ASSIGN_MAX_RETRY=3
JWT_SECRET=YOUR_JWT_SECRET
DEBUG_MODE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

SURGE_FLAT_AMOUNT=
ACTIVE_OFFERS=[]
ACTIVE_SURGES=[]
